# Prueba automática del backend (no necesita ninguna extensión).
# Uso (en PowerShell, con la app ya corriendo):
#   powershell -ExecutionPolicy Bypass -File .\probar.ps1

$base      = "http://localhost:8081"
$adminPass = "admin12345"      # tiene que ser la misma que pusiste en ADMIN_PASSWORD

$n = Get-Random -Minimum 10000 -Maximum 99999     # para poder repetir la prueba sin choques de datos únicos
$ok = 0
$fallo = 0

$anon   = New-Object Microsoft.PowerShell.Commands.WebRequestSession
$admin  = New-Object Microsoft.PowerShell.Commands.WebRequestSession
$alumnoSes = New-Object Microsoft.PowerShell.Commands.WebRequestSession

function Llamar {
    param($Titulo, $Metodo, $Ruta, $Cuerpo, $Sesion, [int]$Esperado)
    $p = @{ Uri = "$base$Ruta"; Method = $Metodo; WebSession = $Sesion; UseBasicParsing = $true }
    if ($Cuerpo) {
        $p.Body = ($Cuerpo | ConvertTo-Json -Depth 5)
        $p.ContentType = "application/json"
    }
    $codigo = 0
    $datos = $null
    try {
        $r = Invoke-WebRequest @p
        $codigo = [int]$r.StatusCode
        if ($r.Content) { $datos = $r.Content | ConvertFrom-Json }
    } catch {
        if ($_.Exception.Response) {
            $codigo = [int]$_.Exception.Response.StatusCode
        } else {
            Write-Host "No se pudo conectar: $($_.Exception.Message)" -ForegroundColor Red
            Write-Host "Revisá que la app esté corriendo y que el puerto de `$base sea el correcto." -ForegroundColor Red
            exit 1
        }
    }
    if ($codigo -eq $Esperado) {
        Write-Host ("[OK]    {0}  -> {1}" -f $Titulo, $codigo) -ForegroundColor Green
        $script:ok++
    } else {
        Write-Host ("[FALLO] {0}  -> dio {1}, se esperaba {2}" -f $Titulo, $codigo, $Esperado) -ForegroundColor Red
        $script:fallo++
    }
    return $datos
}

Write-Host "`n=== LOGIN ===" -ForegroundColor Cyan
Llamar "Sin login no entra a alumnos" GET "/api/alumnos" $null $anon 401 | Out-Null
Llamar "Login con clave mala" POST "/api/auth/login" @{ nombreUsuario = "admin"; contrasena = "clavemala" } $anon 401 | Out-Null
$yo = Llamar "Login como admin" POST "/api/auth/login" @{ nombreUsuario = "admin"; contrasena = $adminPass } $admin 200
if (-not $yo) {
    Write-Host "`nNo se pudo entrar como admin. Casi seguro falta crear el admin:" -ForegroundColor Yellow
    Write-Host "  1) poné ADMIN_PASSWORD=$adminPass en application.properties" -ForegroundColor Yellow
    Write-Host "  2) reiniciá la app y mirá que diga 'Administrador inicial admin creado'" -ForegroundColor Yellow
    exit 1
}
Llamar "Quién soy (me)" GET "/api/auth/me" $null $admin 200 | Out-Null

Write-Host "`n=== DATOS BASE ===" -ForegroundColor Cyan
$alumno = Llamar "Crear alumno" POST "/api/alumnos" @{
    nombre = "Lucia"; apellido = "Gomez"; domicilio = "Calle 123"; telefono = "3814000000"
    email = "lucia$n@mail.com"; dni = "4$n"; fechaNacimiento = "2008-05-10"; fechaIngreso = "2026-03-01"
} $admin 201
$ciclo = Llamar "Crear ciclo lectivo" POST "/api/ciclos-lectivos" @{
    anio = (Get-Random -Minimum 2100 -Maximum 9000); fechaInicio = "2026-03-01"; fechaFin = "2026-12-15"
} $admin 201
if (-not $alumno -or -not $ciclo) { Write-Host "Sin alumno o ciclo no se puede seguir." -ForegroundColor Red; exit 1 }

Write-Host "`n=== USUARIOS ===" -ForegroundColor Cyan
Llamar "Crear usuario ALUMNO vinculado" POST "/api/usuarios" @{
    nombreUsuario = "lucia$n"; contrasena = "lucia12345"; rol = "ALUMNO"; idAlumno = $alumno.id
} $admin 201 | Out-Null
Llamar "Usuario ALUMNO sin idAlumno (debe rechazar)" POST "/api/usuarios" @{
    nombreUsuario = "sinvinculo$n"; contrasena = "12345678"; rol = "ALUMNO"
} $admin 400 | Out-Null

Write-Host "`n=== MATRICULA ===" -ForegroundColor Cyan
$hoy = (Get-Date).ToString("yyyy-MM-dd")
$mat = Llamar "Registrar matricula" POST "/api/matriculas" @{
    fechaMatricula = $hoy; importe = 50000; idAlumno = $alumno.id; idCicloLectivo = $ciclo.id
} $admin 201
Llamar "Matricula duplicada (RN04)" POST "/api/matriculas" @{
    fechaMatricula = $hoy; importe = 50000; idAlumno = $alumno.id; idCicloLectivo = $ciclo.id
} $admin 409 | Out-Null
Llamar "Activar matricula" PATCH "/api/matriculas/$($mat.id)/estado" @{ estado = "ACTIVA" } $admin 200 | Out-Null
Llamar "Volver a PENDIENTE (debe rechazar)" PATCH "/api/matriculas/$($mat.id)/estado" @{ estado = "PENDIENTE" } $admin 409 | Out-Null

Write-Host "`n=== CUOTAS ===" -ForegroundColor Cyan
$venc = (Get-Date).AddDays(15).ToString("yyyy-MM-dd")
$cuotas = Llamar "Generar 3 cuotas" POST "/api/cuotas/generar" @{
    idMatricula = $mat.id; cantidad = 3; importe = 20000; primerVencimiento = $venc
} $admin 201
Llamar "Generar de nuevo (debe rechazar)" POST "/api/cuotas/generar" @{
    idMatricula = $mat.id; cantidad = 3; importe = 20000; primerVencimiento = $venc
} $admin 409 | Out-Null
$deuda = Llamar "Deuda del alumno" GET "/api/cuotas/alumno/$($alumno.id)/deuda" $null $admin 200
if ($deuda) { Write-Host ("        pendientes: {0}  |  importe adeudado: {1}  (esperado: 3 y 60000)" -f $deuda.cuotasPendientes, $deuda.importeAdeudado) }
Llamar "Logout admin" POST "/api/auth/logout" $null $admin 204 | Out-Null

Write-Host "`n=== COMO ALUMNO ===" -ForegroundColor Cyan
Llamar "Login como alumno" POST "/api/auth/login" @{ nombreUsuario = "lucia$n"; contrasena = "lucia12345" } $alumnoSes 200 | Out-Null
Llamar "Alumno ve sus cuotas" GET "/api/cuotas/mis-cuotas" $null $alumnoSes 200 | Out-Null
Llamar "Alumno ve su deuda" GET "/api/cuotas/mi-deuda" $null $alumnoSes 200 | Out-Null
Llamar "Alumno ve sus matriculas" GET "/api/matriculas/mis-matriculas" $null $alumnoSes 200 | Out-Null
Llamar "Alumno NO puede listar usuarios" GET "/api/usuarios" $null $alumnoSes 403 | Out-Null
Llamar "Alumno NO puede ver cuotas de otro alumno" GET "/api/cuotas/alumno/$($alumno.id)" $null $alumnoSes 403 | Out-Null
Llamar "Alumno cambia su contrasena" PUT "/api/auth/contrasena" @{ contrasenaActual = "lucia12345"; contrasenaNueva = "lucia54321" } $alumnoSes 204 | Out-Null
Llamar "Logout alumno" POST "/api/auth/logout" $null $alumnoSes 204 | Out-Null

Write-Host "`n=== RESUMEN ===" -ForegroundColor Cyan
Write-Host "Correctas: $ok   Con fallo: $fallo"
if ($fallo -gt 0) { Write-Host "Copiame las lineas [FALLO] y lo reviso." -ForegroundColor Yellow }